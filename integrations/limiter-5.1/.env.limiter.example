# On host: copy to .env.limiter, chmod 600, generate secrets with openssl rand -hex 32
REMNADROP_LIMITER_BRIDGE_TOKEN=replace_with_64_hex_characters
REMNADROP_LIMITER_WEBHOOK_SECRET=replace_with_another_64_hex_characters

# Existing Telegram bot or a dedicated bot; required by upstream 5.1.0
TELEGRAM_BOT_TOKEN=replace_from_BotFather
TELEGRAM_CHAT_ID=123456789
TELEGRAM_ADMIN_IDS=123456789

# Optional Telegram network proxy if api.telegram.org is unavailable
TELEGRAM_PROXY=

# Optional MaxMind ASN (database downloaded only when key is present)
MAXMIND_LICENSE_KEY=
